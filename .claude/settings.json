{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verifier-tests-avant-commit.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verifier-francais-avant-commit.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verifier-migrations-appliquees-avant-commit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verifier-migration-retrocompatible.sh" }
        ]
      }
    ]
  }
}
