flowchart TB
  subgraph A["Circuit A : demande de places"]
    direction TB
    A1["Un chef de section ou plus demande<br/>des places pour son bord"] --> A2["Un référent de la formation<br/>enregistre l'attribution des<br/>places"] --> A3["Les places sont affectées à des marins"]
  end
  subgraph B["Circuit B : candidature individuelle"]
    direction TB
    B1["Le marin candidate"] --> B2["Validation hiérarchique"] --> B3["Validation du BRH"] --> B4["Transmise à l'organisme, puis<br/>sélectionnée ou refusée"]
  end
  subgraph C["Circuit C : formation gérée par le bord"]
    direction TB
    C1["Proposée ou modifiée par le bord<br/>(active d'emblée si le proposeur<br/>est chef de service)"] --> C2["En attente de validation du chef<br/>de service"] --> C3["Active au catalogue, ou refusée"]
  end
  C ~~~ A
  A ~~~ B
  A3 --> S["Session : réservation, présence,<br/>résultat"]
  B4 --> S
  S --> Q["Validation par un référent :<br/>qualification avec échéance"]
