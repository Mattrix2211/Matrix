flowchart TB
  subgraph TERRE["À terre"]
    CAT["Catalogue de la flotte : catégories et articles,<br/>géré à terre par les responsables de spécialité"]
  end
  subgraph BORD["À bord"]
    direction TB
    EQ["Le bord choisit un article<br/>et indique combien il en a"]
    FI["Matrix crée autant de fiches de matériel<br/>pré-remplies, rattachées à l'article"]
    GR["Saisie en grille : numéro de série,<br/>numéro de bord, emplacement, dates"]
    PL["Matériel placé sur le plan du navire, relié aux<br/>plans de maintenance de sa catégorie"]
    PR["Article absent du catalogue :<br/>le bord propose, circuit de visas"]
  end
  CAT --> EQ
  EQ --> FI
  FI --> GR
  GR --> PL
  PR -->|"visas puis publication"| CAT
