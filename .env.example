# Django
# Production : DJANGO_DEBUG=0 et une clé propre à l'installation (32 caractères minimum), par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Vide en développement (DJANGO_DEBUG=1) : une clé de développement est utilisée. Jamais « change-me », refusé en production.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by docker-compose)
# POSTGRES_PASSWORD est obligatoire : docker-compose.yml refuse de demarrer le service "db"
# si elle n'est pas definie (pas de mot de passe par defaut faible).
POSTGRES_DB=matrix
POSTGRES_USER=matrix
# Développement local seulement (port lié à 127.0.0.1) ; mot de passe réel en production.
POSTGRES_PASSWORD=change-me

# Base de donnees Postgres (optionnel, SQLite est utilise par defaut en dev) : decommenter pour activer Postgres
# DB_NAME=matrix
# DB_USER=matrix
# DB_PASSWORD obligatoire dès que DB_HOST est défini en production ; valeurs d'exemple refusées. Pas de commentaire en fin de ligne.
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Brouillons automatiques : conservation en jours (0 = jamais purgé), taille max en octets
# BROUILLONS_CONSERVATION_JOURS=30
# BROUILLONS_TAILLE_MAX=262144

# Déconnexion automatique après inactivité (secondes) : délai (60 à 28800, 900 par défaut) et préavis (10 à la moitié du délai, 60 par défaut)
# INACTIVITE_DELAI_SECONDES=900
# Taille maximale des documents téléversés, en Mo
# DOCUMENT_TAILLE_MAX_MO=20
# INACTIVITE_AVERTISSEMENT_SECONDES=60
